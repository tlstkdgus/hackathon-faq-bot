# ─────────────────────────────────────────────────────────────
# 환경변수 예시 파일
#
# 사용법
#   1) 이 파일을 복사해서 이름을 .env 로 바꾼다
#        윈도우: copy .env.example .env
#        리눅스: cp .env.example .env
#   2) 아래 값들을 실제 값으로 채운다
#   3) .env 는 절대 git에 커밋하지 않는다 (.gitignore에 등록돼 있음)
#
# 이 파일(.env.example)에는 실제 토큰을 넣지 말 것! 예시만 남긴다.
# ─────────────────────────────────────────────────────────────

# ── 필수 ──────────────────────────────────────────────────────

# 디스코드 봇 토큰
# 발급: https://discord.com/developers/applications → Bot → Reset Token
# 주의: Bot 탭에서 'MESSAGE CONTENT INTENT'를 반드시 켜야 한다.
DISCORD_TOKEN=여기에_디스코드_봇_토큰

# ── 선택 ──────────────────────────────────────────────────────

# 슬래시 커맨드(/해커톤질문 등)를 특정 서버에 '즉시' 반영하고 싶을 때 서버 ID.
# 비워두면 전역 등록이 되는데, 디스코드 반영에 최대 1시간 걸린다.
# 서버 ID 확인: 디스코드 설정 → 고급 → 개발자 모드 ON → 서버 우클릭 → ID 복사
DISCORD_GUILD_ID=

# ── LLM 설정 ──────────────────────────────────────────────────
#
# 키워드로 못 잡는 질문을 자연어로 답하게 하는 부분이다.
# 키를 하나도 안 넣으면 키워드 매칭만으로 동작한다
# (봇은 정상 작동하고, 답변 범위만 좁아진다).

# 주 백엔드 (openai | claude). 기본값 claude.
LLM_PROVIDER=openai

# 주 백엔드가 실패했을 때 넘어갈 백엔드. 비워두면 폴백하지 않는다.
# 행사 당일 한쪽 API에 장애·레이트리밋·크레딧 소진이 생겨도
# 답변이 끊기지 않게 하려면 채워두는 걸 권장한다.
LLM_FALLBACK=claude

# OpenAI — 발급: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# 모델. 기본값 gpt-5.6-luna는 비용 최적화 모델로, FAQ 답변에는
# 상위 모델(sol/terra)과 품질 차이가 거의 없으면서 25분의 1 가격이다.
#   gpt-5.6-luna   $0.20 / $1.20 per MTok   ← 기본값, 이 용도에 충분
#   gpt-5.6-terra  $2 / $12
#   gpt-5.6-sol    $5 / $30
# 라인업은 자주 바뀐다. 모델명이 틀리면 봇 로그에 사용 가능 목록을 찍어준다.
# 최신 목록: https://platform.openai.com/docs/models
OPENAI_MODEL=gpt-5.6-luna

# 추론 강도 (none | low | medium | high | xhigh | max)
# 추론 토큰은 출력 토큰과 같은 단가로 과금되고 응답도 그만큼 느려진다.
# FAQ 봇은 자료를 찾아 옮기는 일이라 추론이 필요 없어 none이 기본값이다.
# 답변이 부실하다 싶을 때만 low로 올려보자.
OPENAI_REASONING=none

OPENAI_TIMEOUT=20

# Claude — 발급: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
ANTHROPIC_TIMEOUT=20

# ── 운영시간 ──────────────────────────────────────────────────

# 질문 받는 시간 (한국시간 기준, 24시간제)
#   0  ~ 24  → 24시간 항상 받기 (기본값)
#   10 ~ 17  → 낮 10시부터 오후 5시까지
#   20 ~ 4   → 밤 8시부터 새벽 4시까지 (자정을 넘기는 설정도 지원)
QA_START_HOUR=0
QA_END_HOUR=24

# 로그 파일(stats.log, unanswered.log)을 저장할 폴더.
# 비워두면 프로젝트 폴더에 그대로 쌓인다.
# 서버에서 git pull로 코드를 업데이트해도 로그를 안전하게 유지하고 싶으면
# 프로젝트 밖 경로를 지정한다. 예: /var/lib/faq-bot
DATA_DIR=
