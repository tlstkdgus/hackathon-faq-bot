# 이 파일을 .env 로 복사한 뒤 값을 채우세요.
#   리눅스: cp .env.example .env
#   윈도우: copy .env.example .env
#
# .env 는 커밋되지 않습니다. 이 예시 파일에는 실제 키를 넣지 마세요.
# 각 항목의 자세한 설명은 README.md 참고.

# ── 필수 ──────────────────────────────────────────────

# 개발자 포털 → Bot → Reset Token (MESSAGE CONTENT INTENT 켜야 함)
DISCORD_TOKEN=

# ── 디스코드 ──────────────────────────────────────────

# 서버 ID. 넣으면 슬래시 커맨드가 즉시 반영됨 (비우면 최대 1시간)
DISCORD_GUILD_ID=

# ── LLM ───────────────────────────────────────────────
# 키를 하나도 안 넣으면 키워드 매칭만으로 동작합니다.

# 주 백엔드 / 실패 시 넘어갈 백엔드 (openai | claude)
LLM_PROVIDER=openai
LLM_FALLBACK=claude

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING=none
OPENAI_TIMEOUT=20

# Claude — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
ANTHROPIC_TIMEOUT=20

# ── 운영 ──────────────────────────────────────────────

# 질문 받는 시간 (한국시간, 24시간제). 0~24 = 항상 열림
QA_START_HOUR=0
QA_END_HOUR=24

# 로그 저장 폴더. 비우면 프로젝트 폴더에 쌓임
DATA_DIR=
