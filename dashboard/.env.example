# 운영용 docker-compose.yml 설정. 복사해서 .env로 쓰고, .env는 커밋하지 않는다.

# 현황판 접근 토큰 (긴 무작위 문자열). 접속: http://<서버>:8080/?token=<이 값>
DASHBOARD_TOKEN=

# 봇 로그 폴더 (봇 .env의 DATA_DIR과 같은 곳. 지정 안 했다면 봇 저장소 폴더)
LOG_DIR=/home/ubuntu/hackathon-faq-bot

# 사용자 ID 별칭을 만들 때 섞는 값. 아무 문자열로 바꿔 두면 된다.
DASHBOARD_ID_SALT=

# 기본은 서버 안에서만 열린다(127.0.0.1). SSH 터널로 접속하는 것을 권장.
# 외부에 열어야 하면 0.0.0.0으로 바꾸고 방화벽(보안 목록)에서 포트를 연다.
BIND_ADDR=127.0.0.1
WEB_PORT=8080
