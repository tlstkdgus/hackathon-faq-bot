# 해커톤 FAQ 봇을 서버에서 상시 실행하기 위한 systemd 유닛 파일.
#
# 이 파일을 직접 손대지 않아도 됩니다. deploy/setup.sh 가 사용자 이름과
# 경로를 알아서 바꿔서 /etc/systemd/system/faq-bot.service 로 설치합니다.
#
# 수동으로 설치하려면 아래 User/WorkingDirectory/ExecStart 경로를 본인 환경에
# 맞게 고친 뒤:
#   sudo cp deploy/faq-bot.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now faq-bot

[Unit]
Description=해커톤 FAQ 디스코드 봇
Documentation=https://github.com/tlstkdgus/hackathon-faq-bot
# 네트워크가 실제로 연결된 뒤에 시작한다. (봇은 부팅 직후 디스코드에 접속해야 함)
After=network-online.target
Wants=network-online.target

# 재시작 횟수 제한을 끈다.
# 기본값은 "10초 안에 5번 실패하면 포기"인데, 디스코드 API 장애나 네트워크
# 문제로 연속 실패하면 봇이 영영 안 살아난다. 0이면 무한정 재시도한다.
#
# 주의: 이 두 항목은 [Service]가 아니라 [Unit] 섹션에 있어야 한다.
# [Service]에 쓰면 systemd가 "Unknown key name" 경고와 함께 무시해서,
# 설정한 줄 알았는데 실제로는 적용이 안 되는 함정이 있다.
StartLimitIntervalSec=0
StartLimitBurst=0

[Service]
Type=simple
User=ubuntu
Group=ubuntu

# 상대경로("faq.md" 등)의 기준이 되는 폴더. 이게 없으면 cwd가 / 가 되어
# FAQ 파일을 못 찾는다. (지금은 코드가 절대경로를 쓰지만 그래도 명시해 둔다.)
WorkingDirectory=/home/ubuntu/hackathon-faq-bot

# 가상환경(venv) 안의 파이썬으로 실행한다.
ExecStart=/home/ubuntu/hackathon-faq-bot/.venv/bin/python /home/ubuntu/hackathon-faq-bot/bot.py

# print() 출력을 버퍼링 없이 즉시 내보낸다.
# 이게 없으면 journalctl에 로그가 한참 뒤에야(또는 아예 안) 나타나서
# "봇이 뜬 건지 죽은 건지" 알 수가 없다. 디버깅에 결정적이다.
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONIOENCODING=utf-8

# 환경변수는 프로젝트 폴더의 .env 파일에서 python-dotenv가 읽어간다.
# (로컬 개발과 서버가 같은 방식이라 헷갈릴 일이 없다.)
# 만약 .env 대신 systemd가 직접 주입하게 하고 싶다면 아래 줄의 주석을 풀고
# /etc/faq-bot.env 에 KEY=VALUE 형식으로 넣으면 된다.
#EnvironmentFile=-/etc/faq-bot.env

# 죽으면 무조건 다시 띄운다. 10초 뒤 재시도.
# (재시작 횟수 제한 해제는 위 [Unit] 섹션 참고)
Restart=always
RestartSec=10

# 로그는 systemd 저널로 (journalctl -u faq-bot -f 로 확인)
StandardOutput=journal
StandardError=journal

# ── 최소한의 보안 설정 ──
# 봇은 파일 몇 개만 읽고 쓰면 되므로 권한을 좁혀둔다.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
